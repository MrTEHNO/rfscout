<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="10dp">

    <RadioGroup
        android:id="@+id/tabGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/tabDf"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:checked="true"
            android:textColor="#C7D0DA"
            android:text="Пеленг" />

        <RadioButton
            android:id="@+id/tabSpectrum"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#C7D0DA"
            android:text="Спектр" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:textColor="#9CA8B6"
                android:textSize="13sp"
                android:text="Все" />

            <RadioButton
                android:id="@+id/modeWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#9CA8B6"
                android:textSize="13sp"
                android:text="Wi-Fi" />

            <RadioButton
                android:id="@+id/modeBle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#9CA8B6"
                android:textSize="13sp"
                android:text="BLE" />

            <RadioButton
                android:id="@+id/modeBtc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#9CA8B6"
                android:textSize="13sp"
                android:text="BT" />
        </RadioGroup>

        <TextView
            android:id="@+id/coverageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5B6675"
            android:textSize="12sp"
            android:text="0%" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ua.sem.rfscout.CompassView
                android:id="@+id/compass"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/hintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="8dp"
                android:textColor="#4E9E6C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="Обери ціль зі списку" />

            <TextView
                android:id="@+id/distText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:paddingBottom="6dp"
                android:textColor="#7C8A9A"
                android:textSize="14sp"
                android:text="—" />

            <ListView
                android:id="@+id/targetList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.9"
                android:divider="#0E141B"
                android:dividerHeight="1dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/resetBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Скинути" />

                <Button
                    android:id="@+id/calibBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1.3"
                    android:layout_height="wrap_content"
                    android:text="Калібр. 1 м" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ua.sem.rfscout.SpectrumView
                android:id="@+id/spectrum"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/spectrumNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textColor="#5B6675"
                android:textSize="12sp"
                android:text="Показані розпізнані передавачі, а не рівень шуму. Порожня ділянка — немає відомих мереж, а не вільна частота." />
        </LinearLayout>
    </ViewFlipper>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:textColor="#2E3743"
        android:textSize="10sp"
        android:text="Sem_TEHNO" />

</LinearLayout>
